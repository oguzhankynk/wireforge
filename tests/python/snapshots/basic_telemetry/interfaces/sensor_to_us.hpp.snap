/// @brief Receives the messages of this interface, decoded or as raw bytes.
class Handler {
public:
    /// @brief Called for every valid SensorReading received on this interface.
    virtual void onSensorReadingReceived(const SensorReading& message) noexcept = 0;
    /**
     * @brief Called for every SensorReading frame before its payload is decoded.
