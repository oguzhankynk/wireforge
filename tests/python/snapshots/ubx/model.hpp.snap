/// @return false, and the field unchanged, when the raw value does not fit.
[[nodiscard]] inline bool set_physical_NavPvt_lat(NavPvt& value, double physical) noexcept {
    const double raw = (physical - 0.0) / 1e-07;
    const bool fits = raw > -2147483648.5 && raw < 2147483647.5;
    if (!fits) {
        return false;
