/// @brief Appends the wire form of @p value to @p encoder.
inline void encode(const NavPvt& value, wireforge::Encoder& encoder) noexcept {
    encoder.write(value.iTow);
    encoder.write(value.year);
    encoder.write(value.month);
    encoder.write(value.day);
    encoder.write(value.hour);
    encoder.write(value.min);
    encoder.write(value.sec);
    {
        wireforge::BitPacker group(8U, encoder.encoding().bit_order);
        encoder.put(group, value.valid.validDate, 1U);
        encoder.put(group, value.valid.validTime, 1U);
        encoder.put(group, value.valid.fullyResolved, 1U);
        encoder.put(group, value.valid.validMag, 1U);
        encoder.put(group, 0U, 4U);
        encoder.write_bits(group);
    }
    encoder.write(value.tAcc);
    encoder.write(value.nano);
    encoder.write(value.fixType);
    {
        wireforge::BitPacker group(16U, encoder.encoding().bit_order);
        encoder.put(group, value.flags.gnssFixOk, 1U);
        encoder.put(group, value.flags.diffSoln, 1U);
        encoder.put(group, value.flags.psmState, 3U);
        encoder.put(group, value.flags.headVehValid, 1U);
        encoder.put(group, value.flags.carrSoln, 2U);
        encoder.put(group, 0U, 5U);
        encoder.put(group, value.flags2.confirmedAvai, 1U);
        encoder.put(group, value.flags2.confirmedDate, 1U);
        encoder.put(group, value.flags2.confirmedTime, 1U);
        encoder.write_bits(group);
    }
    encoder.write(value.numSv);
    encoder.write(value.lon);
    encoder.write(value.lat);
    encoder.write(value.height);
    encoder.write(value.hMsl);
    encoder.write(value.hAcc);
    encoder.write(value.vAcc);
    encoder.write(value.velN);
    encoder.write(value.velE);
    encoder.write(value.velD);
    encoder.write(value.gSpeed);
    encoder.write(value.headMot);
    encoder.write(value.sAcc);
    encoder.write(value.headAcc);
    encoder.write(value.pDop);
    encoder.write(value.flags3);
    encoder.write<std::uint32_t>(0U);
    encoder.write(value.headVeh);
    encoder.write(value.magDec);
    encoder.write(value.magAcc);
}

/// @brief Reads @p value from @p decoder.
inline void decode(NavPvt& value, wireforge::Decoder& decoder) noexcept {
    decoder.read(value.iTow);
    decoder.read(value.year);
    decoder.read(value.month);
    decoder.read(value.day);
    decoder.read(value.hour);
    decoder.read(value.min);
    decoder.read(value.sec);
    {
        wireforge::BitUnpacker group = decoder.read_bits(8U);
        decoder.get(group, value.valid.validDate, 1U);
        decoder.get(group, value.valid.validTime, 1U);
        decoder.get(group, value.valid.fullyResolved, 1U);
        decoder.get(group, value.valid.validMag, 1U);
        decoder.skip_bits(group, 4U);
    }
    decoder.read(value.tAcc);
    decoder.read(value.nano);
    decoder.read(value.fixType);
    {
        wireforge::BitUnpacker group = decoder.read_bits(16U);
        decoder.get(group, value.flags.gnssFixOk, 1U);
        decoder.get(group, value.flags.diffSoln, 1U);
        decoder.get(group, value.flags.psmState, 3U);
        decoder.get(group, value.flags.headVehValid, 1U);
        decoder.get(group, value.flags.carrSoln, 2U);
        decoder.skip_bits(group, 5U);
        decoder.get(group, value.flags2.confirmedAvai, 1U);
        decoder.get(group, value.flags2.confirmedDate, 1U);
        decoder.get(group, value.flags2.confirmedTime, 1U);
    }
    decoder.read(value.numSv);
    decoder.read(value.lon);
    decoder.read(value.lat);
    decoder.read(value.height);
    decoder.read(value.hMsl);
    decoder.read(value.hAcc);
    decoder.read(value.vAcc);
    decoder.read(value.velN);
    decoder.read(value.velE);
    decoder.read(value.velD);
    decoder.read(value.gSpeed);
    decoder.read(value.headMot);
    decoder.read(value.sAcc);
    decoder.read(value.headAcc);
    decoder.read(value.pDop);
    decoder.read(value.flags3);
    decoder.skip(4U);
    decoder.read(value.headVeh);
    decoder.read(value.magDec);
    decoder.read(value.magAcc);
}

/// @brief Encoding of NavPvt without interface overrides.
inline constexpr wireforge::Encoding kNavPvtEncoding = wireforge::Encoding{wireforge::Endian::Little, wireforge::BitOrder::LsbFirst, true, true, false};

/**
 * @brief Encodes the payload of a NavPvt message into @p buffer.
 * @param value Message to encode.
 * @param buffer Destination of the payload.
 * @param[out] size Number of bytes written (0 on error).
 * @param encoding Byte order, bit order and range checks.
 * @return The first error, or wireforge::Status::Ok.
 */
[[nodiscard]] inline wireforge::Status serialize(const NavPvt& value, wireforge::Span<std::uint8_t> buffer, std::size_t& size, const wireforge::Encoding& encoding = kNavPvtEncoding) noexcept {
    wireforge::Encoder encoder(buffer, encoding);
    encode(value, encoder);
    size = encoder.status() == wireforge::Status::Ok ? encoder.position() : 0U;
    return encoder.status();
}

/**
 * @brief Decodes the payload of a NavPvt message.
 * @param payload Encoded payload.
 * @param[out] value Decoded message (partially filled on error).
 * @param encoding Byte order, bit order and range checks.
 * @return The first error, or wireforge::Status::Ok.
 */
[[nodiscard]] inline wireforge::Status deserialize(wireforge::Span<const std::uint8_t> payload, NavPvt& value, const wireforge::Encoding& encoding = kNavPvtEncoding) noexcept {
    wireforge::Decoder decoder(payload, encoding);
    decode(value, decoder);
    decoder.finish();
    return decoder.status();
}

/// @brief Receiver and software version (MON-VER, class 0x0A, id 0x04).
/// Defined in project.yaml:132 (/messages/MonVer).
/// Requirements: LLR-MonVer.LAYOUT, LLR-MonVer.SIZE, LLR-MonVer.TRUNCATED, LLR-MonVer.TRAILING,
/// LLR-MonVer.swVersion.COUNT, LLR-MonVer.swVersion.CHARS, LLR-MonVer.hwVersion.COUNT,
/// LLR-MonVer.hwVersion.CHARS, LLR-MonVer.extensions.COUNT
struct MonVer {
    wireforge::FixedString<30U> swVersion; ///< swVersion (project.yaml:136)
    wireforge::FixedString<10U> hwVersion; ///< hwVersion (project.yaml:137)
    wireforge::StaticVector<Extension, 8U> extensions; ///< extensions (project.yaml:138)
};

/// @brief Checks ranges, enum values and element counts of @p value.
[[nodiscard]] constexpr wireforge::Status validate(const MonVer& value) noexcept {
    return wireforge::first_error(
        wireforge::validate_each(value.extensions),
        wireforge::Status::Ok);
}

/// @brief Smallest encoded size of MonVer in bytes.
[[nodiscard]] constexpr std::size_t min_wire_size(wireforge::TypeTag<MonVer> /*tag*/) noexcept {
    std::size_t size = 0U;
    size += std::size_t{30U} * 1U;
    size += std::size_t{10U} * 1U;
    return size;
}

/// @brief Largest encoded size of MonVer in bytes.
[[nodiscard]] constexpr std::size_t max_wire_size(wireforge::TypeTag<MonVer> /*tag*/) noexcept {
    std::size_t size = 0U;
    size += std::size_t{30U} * 1U;
    size += std::size_t{10U} * 1U;
    size += std::size_t{8U} * max_wire_size(wireforge::type_tag<Extension>);
    return size;
}

/// @brief Appends the wire form of @p value to @p encoder.
inline void encode(const MonVer& value, wireforge::Encoder& encoder) noexcept {
    encoder.write_text(value.swVersion, 30U);
    encoder.write_text(value.hwVersion, 10U);
    for (const auto& element : value.extensions) {
        encode(element, encoder);
    }
}

/// @brief Reads @p value from @p decoder.
inline void decode(MonVer& value, wireforge::Decoder& decoder) noexcept {
    decoder.read_text(value.swVersion, 30U, true);
    decoder.read_text(value.hwVersion, 10U, true);
    decoder.resize(value.extensions, decoder.fill_count(max_wire_size(wireforge::type_tag<Extension>)), 0U);
    for (auto& element : value.extensions) {
        decode(element, decoder);
    }
}

/// @brief Encoding of MonVer without interface overrides.
inline constexpr wireforge::Encoding kMonVerEncoding = wireforge::Encoding{wireforge::Endian::Little, wireforge::BitOrder::LsbFirst, true, true, false};

/**
 * @brief Encodes the payload of a MonVer message into @p buffer.
 * @param value Message to encode.
 * @param buffer Destination of the payload.
 * @param[out] size Number of bytes written (0 on error).
 * @param encoding Byte order, bit order and range checks.
 * @return The first error, or wireforge::Status::Ok.
 */
[[nodiscard]] inline wireforge::Status serialize(const MonVer& value, wireforge::Span<std::uint8_t> buffer, std::size_t& size, const wireforge::Encoding& encoding = kMonVerEncoding) noexcept {
    wireforge::Encoder encoder(buffer, encoding);
    encode(value, encoder);
    size = encoder.status() == wireforge::Status::Ok ? encoder.position() : 0U;
    return encoder.status();
}

/**
 * @brief Decodes the payload of a MonVer message.
 * @param payload Encoded payload.
 * @param[out] value Decoded message (partially filled on error).
 * @param encoding Byte order, bit order and range checks.
 * @return The first error, or wireforge::Status::Ok.
 */
[[nodiscard]] inline wireforge::Status deserialize(wireforge::Span<const std::uint8_t> payload, MonVer& value, const wireforge::Encoding& encoding = kMonVerEncoding) noexcept {
    wireforge::Decoder decoder(payload, encoding);
    decode(value, decoder);
    decoder.finish();
    return decoder.status();
}

