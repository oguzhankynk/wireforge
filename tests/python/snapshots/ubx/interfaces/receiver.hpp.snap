/**
 * @brief Reads and checks the header of a complete frame.
 * @param frame Frame as delivered by the frame decoder.
 * @param header Frame header; every field of it is automatic.
 * @return ConstMismatch for a wrong sync, constant or protocol version,
 *         Truncated for a short frame, otherwise wireforge::Status::Ok.
 */
[[nodiscard]] inline wireforge::Status decode_header(wireforge::Span<const std::uint8_t> frame,
                                             const Header& header) noexcept {
    static_cast<void>(header);
    const bool complete = frame.size() >= kHeaderSize + kTrailerSize;
    wireforge::Decoder decoder(frame.first(kHeaderSize), kFrameEncoding);
    decoder.check(complete ? wireforge::Status::Ok
                           : wireforge::Status::Truncated);
    decoder.expect<std::uint16_t>(25269U);
    decoder.skip(2U);
    decoder.skip(2U);
    return decoder.status();
}

/// @brief Receives the messages of this interface, decoded or as raw bytes.
class Handler {
public:
    /// @brief Called for every valid AckAck received on this interface.
    virtual void onAckAckReceived(const AckAck& message) noexcept = 0;
    /**
     * @brief Called for every AckAck frame before its payload is decoded.
     *
     * The default implementation decodes the payload and calls
     * onAckAckReceived() when it is valid. Override it to take the
     * bytes without decoding: framing, the frame checksum and the message
     * id were checked, the payload was not. @p raw points into the receive
     * buffer and is valid only during this call.
     * @return Reported to the link; the default returns the decode status.
     */
    virtual wireforge::Status onAckAckRaw(
        const wireforge::RawMessage& raw) noexcept {
        AckAck message{};
        const wireforge::Status status =
            deserialize(raw.payload, message, kAckAckEncoding);
        if (status == wireforge::Status::Ok) {
            onAckAckReceived(message);
        }
        return status;
    }
    /// @brief Called for every valid AckNak received on this interface.
    virtual void onAckNakReceived(const AckNak& message) noexcept = 0;
    /**
     * @brief Called for every AckNak frame before its payload is decoded.
     *
     * The default implementation decodes the payload and calls
     * onAckNakReceived() when it is valid. Override it to take the
     * bytes without decoding: framing, the frame checksum and the message
     * id were checked, the payload was not. @p raw points into the receive
     * buffer and is valid only during this call.
     * @return Reported to the link; the default returns the decode status.
     */
    virtual wireforge::Status onAckNakRaw(
        const wireforge::RawMessage& raw) noexcept {
        AckNak message{};
        const wireforge::Status status =
            deserialize(raw.payload, message, kAckNakEncoding);
        if (status == wireforge::Status::Ok) {
            onAckNakReceived(message);
        }
        return status;
    }
    /// @brief Called for every valid CfgRate received on this interface.
    virtual void onCfgRateReceived(const CfgRate& message) noexcept = 0;
    /**
     * @brief Called for every CfgRate frame before its payload is decoded.
     *
     * The default implementation decodes the payload and calls
     * onCfgRateReceived() when it is valid. Override it to take the
     * bytes without decoding: framing, the frame checksum and the message
     * id were checked, the payload was not. @p raw points into the receive
     * buffer and is valid only during this call.
     * @return Reported to the link; the default returns the decode status.
     */
    virtual wireforge::Status onCfgRateRaw(
        const wireforge::RawMessage& raw) noexcept {
        CfgRate message{};
        const wireforge::Status status =
            deserialize(raw.payload, message, kCfgRateEncoding);
        if (status == wireforge::Status::Ok) {
            onCfgRateReceived(message);
        }
        return status;
    }
    /// @brief Called for every valid NavPvt received on this interface.
    virtual void onNavPvtReceived(const NavPvt& message) noexcept = 0;
    /**
     * @brief Called for every NavPvt frame before its payload is decoded.
     *
     * The default implementation decodes the payload and calls
     * onNavPvtReceived() when it is valid. Override it to take the
     * bytes without decoding: framing, the frame checksum and the message
     * id were checked, the payload was not. @p raw points into the receive
     * buffer and is valid only during this call.
     * @return Reported to the link; the default returns the decode status.
     */
    virtual wireforge::Status onNavPvtRaw(
        const wireforge::RawMessage& raw) noexcept {
        NavPvt message{};
        const wireforge::Status status =
            deserialize(raw.payload, message, kNavPvtEncoding);
        if (status == wireforge::Status::Ok) {
            onNavPvtReceived(message);
        }
        return status;
    }
    /// @brief Called for every valid MonVer received on this interface.
    virtual void onMonVerReceived(const MonVer& message) noexcept = 0;
    /**
     * @brief Called for every MonVer frame before its payload is decoded.
     *
     * The default implementation decodes the payload and calls
     * onMonVerReceived() when it is valid. Override it to take the
     * bytes without decoding: framing, the frame checksum and the message
     * id were checked, the payload was not. @p raw points into the receive
     * buffer and is valid only during this call.
     * @return Reported to the link; the default returns the decode status.
     */
    virtual wireforge::Status onMonVerRaw(
        const wireforge::RawMessage& raw) noexcept {
        MonVer message{};
        const wireforge::Status status =
            deserialize(raw.payload, message, kMonVerEncoding);
        if (status == wireforge::Status::Ok) {
            onMonVerReceived(message);
        }
        return status;
    }

protected:
    Handler() = default;                          ///< Constructed by subclasses.
    Handler(const Handler&) = default;            ///< Copy for derived classes.
    Handler& operator=(const Handler&) = default; ///< Copy for derived classes.
    Handler(Handler&&) = default;                 ///< Move for derived classes.
    Handler& operator=(Handler&&) = default;      ///< Move for derived classes.
    /// @brief Not virtual: handlers are never deleted through a Handler pointer.
    ~Handler() = default;
};

/// @brief Forwards the messages of this interface to a Handler.
class Receiver {
public:
    /// @brief Forwards to @p handler, which must outlive the receiver.
    explicit Receiver(Handler& handler) noexcept : handler_(&handler) {}

    /**
     * @brief Registers this receiver with @p dispatcher (before `dispatcher.start()`).
     * @return The first registration error, or wireforge::Status::Ok.
     */
    [[nodiscard]] wireforge::Status attach(Dispatcher& dispatcher) noexcept {
        return wireforge::first_error(
            dispatcher.add(kAckAckId, wireforge::MessageHandler::bind<&Receiver::receiveAckAck>(*this)),
            dispatcher.add(kAckNakId, wireforge::MessageHandler::bind<&Receiver::receiveAckNak>(*this)),
            dispatcher.add(kCfgRateId, wireforge::MessageHandler::bind<&Receiver::receiveCfgRate>(*this)),
            dispatcher.add(kNavPvtId, wireforge::MessageHandler::bind<&Receiver::receiveNavPvt>(*this)),
            dispatcher.add(kMonVerId, wireforge::MessageHandler::bind<&Receiver::receiveMonVer>(*this)),
            wireforge::Status::Ok);
    }

private:
    wireforge::Status receiveAckAck(const wireforge::RawMessage& raw) noexcept {
        return handler_->onAckAckRaw(raw);
    }

    wireforge::Status receiveAckNak(const wireforge::RawMessage& raw) noexcept {
        return handler_->onAckNakRaw(raw);
    }

    wireforge::Status receiveCfgRate(const wireforge::RawMessage& raw) noexcept {
        return handler_->onCfgRateRaw(raw);
    }

    wireforge::Status receiveNavPvt(const wireforge::RawMessage& raw) noexcept {
        return handler_->onNavPvtRaw(raw);
    }

    wireforge::Status receiveMonVer(const wireforge::RawMessage& raw) noexcept {
        return handler_->onMonVerRaw(raw);
    }

    Handler* handler_;
};

/**
 * @brief Receive side of this interface: frame decoder, dispatcher and receiver.
 *
 * Construct it, check status(), then pass decoder() and dispatcher() to a Link.
 */
class Endpoint {
public:
    /// @brief Wires a receiver for @p handler and starts the dispatcher.
    explicit Endpoint(Handler& handler) noexcept
        : receiver_(handler), status_(wire(receiver_, dispatcher_)) {}

    /// @brief Result of the registration; must be Ok before use.
    [[nodiscard]] wireforge::Status status() const noexcept { return status_; }
    /// @brief Frame decoder for the Link.
    [[nodiscard]] Decoder& decoder() noexcept { return decoder_; }
    /// @brief Dispatcher for the Link.
    [[nodiscard]] const Dispatcher& dispatcher() const noexcept {
        return dispatcher_;
    }

private:
    static wireforge::Status wire(Receiver& receiver, Dispatcher& dispatcher) noexcept {
        const wireforge::Status attached = receiver.attach(dispatcher);
        return wireforge::first_error(attached, dispatcher.start());
    }

    Decoder decoder_{kFrameFormat};
    Dispatcher dispatcher_{kHeaderLayout};
    Receiver receiver_;
    wireforge::Status status_;
};

