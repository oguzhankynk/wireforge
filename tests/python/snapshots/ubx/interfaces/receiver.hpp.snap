 * @return The first error, or wireforge::Status::Ok.
 */
[[nodiscard]] inline wireforge::Status encode_frame(const AckAck& message,
                                            wireforge::Span<std::uint8_t> buffer, std::size_t& size,
                                            const Header& header = Header{})
