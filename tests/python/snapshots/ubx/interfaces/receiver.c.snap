    const wf_raw_message raw = {&frame[gnss_ubx_receiver_HEADER_SIZE], size - (gnss_ubx_receiver_HEADER_SIZE + gnss_ubx_receiver_TRAILER_SIZE), frame, size};
    if (message_id == (uint64_t)gnss_ubx_receiver_AckAck_ID) {
        return gnss_ubx_receiver_receive_AckAck(handler, &raw);
    }
    if (message_id == (uint64_t)gnss_ubx_receiver_AckNak_ID) {
        return gnss_ubx_receiver_receive_AckNak(handler, &raw);
    }
    if (message_id == (uint64_t)gnss_ubx_receiver_CfgRate_ID) {
        return gnss_ubx_receiver_receive_CfgRate(handler, &raw);
    }
    if (message_id == (uint64_t)gnss_ubx_receiver_NavPvt_ID) {
        return gnss_ubx_receiver_receive_NavPvt(handler, &raw);
    }
    if (message_id == (uint64_t)gnss_ubx_receiver_MonVer_ID) {
        return gnss_ubx_receiver_receive_MonVer(handler, &raw);
    }
    return WF_UNKNOWN_MESSAGE_ID;
}

