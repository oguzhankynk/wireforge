wf_status gnss_ubx_NavPvt_serialize(const gnss_ubx_NavPvt *value, uint8_t *buffer, size_t capacity, size_t *size)
{
    return gnss_ubx_NavPvt_serialize_with(value, buffer, capacity, size, &gnss_ubx_NavPvt_encoding);
}

wf_status gnss_ubx_NavPvt_deserialize_with(const uint8_t *payload, size_t size, gnss_ubx_NavPvt *value, const wf_encoding *encoding)
{
    wf_decoder decoder;
    wf_decoder_init(&decoder, payload, size, encoding);
    gnss_ubx_NavPvt_decode(value, &decoder);
    wf_dec_finish(&decoder);
    return decoder.status;
}

wf_status gnss_ubx_NavPvt_deserialize(const uint8_t *payload, size_t size, gnss_ubx_NavPvt *value)
{
    return gnss_ubx_NavPvt_deserialize_with(payload, size, value, &gnss_ubx_NavPvt_encoding);
}

void gnss_ubx_MonVer_init(gnss_ubx_MonVer *value)
{
    (void)memset(value, 0, sizeof(*value));
}

wf_status gnss_ubx_MonVer_validate(const gnss_ubx_MonVer *value)
{
    wf_status status = WF_OK;
    for (size_t index = 0U; index < value->extensions_count; ++index) {
    status = wf_first_error(status, gnss_ubx_Extension_validate(&value->extensions[index]));
    }
    return status;
}

void gnss_ubx_MonVer_encode(const gnss_ubx_MonVer *value, wf_encoder *encoder)
{
    wf_enc_text(encoder, value->swVersion, value->swVersion_count, 30U);
    wf_enc_text(encoder, value->hwVersion, value->hwVersion_count, 10U);
    for (size_t index = 0U; index < value->extensions_count; ++index) {
        gnss_ubx_Extension_encode(&value->extensions[index], encoder);
    }
}

void gnss_ubx_MonVer_decode(gnss_ubx_MonVer *value, wf_decoder *decoder)
{
    wf_dec_text(decoder, value->swVersion, 30U, &value->swVersion_count, 30U, true);
    wf_dec_text(decoder, value->hwVersion, 10U, &value->hwVersion_count, 10U, true);
    wf_dec_resize(decoder, &value->extensions_count, wf_dec_fill_count(decoder, gnss_ubx_Extension_MAX_WIRE_SIZE), 0U, 8U);
    for (size_t index = 0U; index < value->extensions_count; ++index) {
        gnss_ubx_Extension_init(&value->extensions[index]);
        gnss_ubx_Extension_decode(&value->extensions[index], decoder);
    }
}

const wf_encoding gnss_ubx_MonVer_encoding = {WF_LITTLE_ENDIAN, WF_LSB_FIRST, true, true, false};

wf_status gnss_ubx_MonVer_serialize_with(const gnss_ubx_MonVer *value, uint8_t *buffer, size_t capacity, size_t *size, const wf_encoding *encoding)
{
    wf_encoder encoder;
    wf_encoder_init(&encoder, buffer, capacity, encoding);
    gnss_ubx_MonVer_encode(value, &encoder);
    *size = wf_encoder_size(&encoder);
    return encoder.status;
}

wf_status gnss_ubx_MonVer_serialize(const gnss_ubx_MonVer *value, uint8_t *buffer, size_t capacity, size_t *size)
{
    return gnss_ubx_MonVer_serialize_with(value, buffer, capacity, size, &gnss_ubx_MonVer_encoding);
}

wf_status gnss_ubx_MonVer_deserialize_with(const uint8_t *payload, size_t size, gnss_ubx_MonVer *value, const wf_encoding *encoding)
{
    wf_decoder decoder;
    wf_decoder_init(&decoder, payload, size, encoding);
    gnss_ubx_MonVer_decode(value, &decoder);
    wf_dec_finish(&decoder);
    return decoder.status;
}

wf_status gnss_ubx_MonVer_deserialize(const uint8_t *payload, size_t size, gnss_ubx_MonVer *value)
{
    return gnss_ubx_MonVer_deserialize_with(payload, size, value, &gnss_ubx_MonVer_encoding);
}
