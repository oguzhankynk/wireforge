/**
 * @brief Encodes a complete NavSolution frame (header, payload, trailer).
 * @param message Message to send.
 * @param buffer Destination of the frame.
 * @param[out] size Frame size in bytes (0 on error).
 * @param header Sender-controlled header fields.
 * @return The first error, or wireforge::Status::Ok.
 */
[[nodiscard]] inline wireforge::Status encode_frame(const NavSolution& message,
                                            wireforge::Span<std::uint8_t> buffer, std::size_t& size,
                                            const Header& header = Header{})
    noexcept {
    return detail::write_frame(header, kNavSolutionId, buffer, size,
        [&message](wireforge::Span<std::uint8_t> payload, std::size_t& payload_size) {
            return serialize(message, payload, payload_size, kNavSolutionEncoding);
        });
}

/**
 * @brief Reads and checks the header of a complete frame.
 * @param frame Frame as delivered by the frame decoder.
 * @param header Frame header; every field of it is automatic.
 * @return ConstMismatch for a wrong sync, constant or protocol version,
 *         Truncated for a short frame, otherwise wireforge::Status::Ok.
 */
[[nodiscard]] inline wireforge::Status decode_header(wireforge::Span<const std::uint8_t> frame,
                                             const Header& header) noexcept {
    static_cast<void>(header);
    const bool complete = frame.size() >= kHeaderSize + kTrailerSize;
    wireforge::Decoder decoder(frame.first(kHeaderSize), kFrameEncoding);
    decoder.check(complete ? wireforge::Status::Ok
                           : wireforge::Status::Truncated);
    decoder.expect<std::uint16_t>(42330U);
    decoder.expect<std::uint8_t>(1U);
    decoder.skip(2U);
    decoder.skip(2U);
    return decoder.status();
}

/// @cond INTERNAL
namespace detail {

