wf_status drone_mavlink2_link_link_send_CommandAck(drone_mavlink2_link_link *link, const drone_mavlink2_CommandAck *message, const drone_mavlink2_link_header *header)
{
    size_t size = 0U;
    const wf_status status = drone_mavlink2_link_encode_CommandAck(message, header, link->tx_frame, drone_mavlink2_link_MAX_FRAME_SIZE, &size);
    return wf_link_send_encoded(&link->link, status, size);
}
