        return drone_mavlink2_link_receive_Heartbeat(handler, &raw);
    }
    if (message_id == (uint64_t)drone_mavlink2_link_GpsRawInt_ID) {
        return drone_mavlink2_link_receive_GpsRawInt(handler, &raw);
    }
    if (message_id == (uint64_t)drone_mavlink2_link_Attitude_ID) {
        return drone_mavlink2_link_receive_Attitude(handler, &raw);
    }
    if (message_id == (uint64_t)drone_mavlink2_link_GlobalPositionInt_ID) {
        return drone_mavlink2_link_receive_GlobalPositionInt(handler, &raw);
    }
    if (message_id == (uint64_t)drone_mavlink2_link_CommandLong_ID) {
        return drone_mavlink2_link_receive_CommandLong(handler, &raw);
    }
    if (message_id == (uint64_t)drone_mavlink2_link_CommandAck_ID) {
        return drone_mavlink2_link_receive_CommandAck(handler, &raw);
    }
    return WF_UNKNOWN_MESSAGE_ID;
}

