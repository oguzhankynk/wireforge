/// @brief Receives the messages of this interface, decoded or as raw bytes.
class Handler {
public:
    /// @brief Called for every valid Heartbeat received on this interface.
    virtual void onHeartbeatReceived(const Heartbeat& message) noexcept = 0;
    /**
     * @brief Called for every Heartbeat frame before its payload is decoded.
     *
     * The default implementation decodes the payload and calls
     * onHeartbeatReceived() when it is valid. Override it to take the
     * bytes without decoding: framing, the frame checksum and the message
     * id were checked, the payload was not. @p raw points into the receive
     * buffer and is valid only during this call.
     * @return Reported to the link; the default returns the decode status.
     */
    virtual wireforge::Status onHeartbeatRaw(
        const wireforge::RawMessage& raw) noexcept {
        // raw.payload lacks the trailing zero bytes that were not sent; they are
        // read as zeros.
        Heartbeat message{};
        const wireforge::ZeroExtended<max_wire_size(wireforge::type_tag<Heartbeat>)>
            payload(raw.payload);
        const wireforge::Status status =
            deserialize(payload.span(), message, kHeartbeatEncoding);
        if (status == wireforge::Status::Ok) {
            onHeartbeatReceived(message);
        }
        return status;
    }
    /// @brief Called for every valid GpsRawInt received on this interface.
    virtual void onGpsRawIntReceived(const GpsRawInt& message) noexcept = 0;
    /**
     * @brief Called for every GpsRawInt frame before its payload is decoded.
