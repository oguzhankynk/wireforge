    /// @brief Called for every valid GlobalPositionInt received on this interface.
    virtual void onGlobalPositionIntReceived(const GlobalPositionInt& message) noexcept = 0;
    /**
     * @brief Called for every GlobalPositionInt frame before its payload is decoded.
     *
