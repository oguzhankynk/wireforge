protected:
    Handler() = default;                          ///< Constructed by subclasses.
    Handler(const Handler&) = default;            ///< Copy for derived classes.
    Handler& operator=(const Handler&) = default; ///< Copy for derived classes.
    Handler(Handler&&) = default;                 ///< Move for derived classes.
    Handler& operator=(Handler&&) = default;      ///< Move for derived classes.
    /// @brief Not virtual: handlers are never deleted through a Handler pointer.
    ~Handler() = default;
};

/// @brief Forwards the messages of this interface to a Handler.
class Receiver {
public:
    /// @brief Forwards to @p handler, which must outlive the receiver.
    explicit Receiver(Handler& handler) noexcept : handler_(&handler) {}

    /**
     * @brief Registers this receiver with @p dispatcher (before `dispatcher.start()`).
     * @return The first registration error, or wireforge::Status::Ok.
     */
    [[nodiscard]] wireforge::Status attach(Dispatcher& dispatcher) noexcept {
        return wireforge::first_error(
            dispatcher.add(kHeartbeatId, wireforge::MessageHandler::bind<&Receiver::receiveHeartbeat>(*this)),
            dispatcher.add(kGpsRawIntId, wireforge::MessageHandler::bind<&Receiver::receiveGpsRawInt>(*this)),
            dispatcher.add(kAttitudeId, wireforge::MessageHandler::bind<&Receiver::receiveAttitude>(*this)),
            dispatcher.add(kGlobalPositionIntId, wireforge::MessageHandler::bind<&Receiver::receiveGlobalPositionInt>(*this)),
            dispatcher.add(kCommandLongId, wireforge::MessageHandler::bind<&Receiver::receiveCommandLong>(*this)),
            dispatcher.add(kCommandAckId, wireforge::MessageHandler::bind<&Receiver::receiveCommandAck>(*this)),
            wireforge::Status::Ok);
    }

private:
    wireforge::Status receiveHeartbeat(const wireforge::RawMessage& raw) noexcept {
        const wireforge::Status checked = detail::check_frame(raw.frame);
        return checked == wireforge::Status::Ok ? handler_->onHeartbeatRaw(raw) : checked;
    }

    wireforge::Status receiveGpsRawInt(const wireforge::RawMessage& raw) noexcept {
        const wireforge::Status checked = detail::check_frame(raw.frame);
        return checked == wireforge::Status::Ok ? handler_->onGpsRawIntRaw(raw) : checked;
    }

    wireforge::Status receiveAttitude(const wireforge::RawMessage& raw) noexcept {
        const wireforge::Status checked = detail::check_frame(raw.frame);
        return checked == wireforge::Status::Ok ? handler_->onAttitudeRaw(raw) : checked;
    }

    wireforge::Status receiveGlobalPositionInt(const wireforge::RawMessage& raw) noexcept {
        const wireforge::Status checked = detail::check_frame(raw.frame);
        return checked == wireforge::Status::Ok ? handler_->onGlobalPositionIntRaw(raw) : checked;
    }

    wireforge::Status receiveCommandLong(const wireforge::RawMessage& raw) noexcept {
        const wireforge::Status checked = detail::check_frame(raw.frame);
        return checked == wireforge::Status::Ok ? handler_->onCommandLongRaw(raw) : checked;
    }

    wireforge::Status receiveCommandAck(const wireforge::RawMessage& raw) noexcept {
        const wireforge::Status checked = detail::check_frame(raw.frame);
        return checked == wireforge::Status::Ok ? handler_->onCommandAckRaw(raw) : checked;
    }

    Handler* handler_;
};

/**
 * @brief Receive side of this interface: frame decoder, dispatcher and receiver.
 *
 * Construct it, check status(), then pass decoder() and dispatcher() to a Link.
 */
class Endpoint {
public:
    /// @brief Wires a receiver for @p handler and starts the dispatcher.
    explicit Endpoint(Handler& handler) noexcept
        : receiver_(handler), status_(wire(receiver_, dispatcher_)) {}

    /// @brief Result of the registration; must be Ok before use.
    [[nodiscard]] wireforge::Status status() const noexcept { return status_; }
    /// @brief Frame decoder for the Link.
    [[nodiscard]] Decoder& decoder() noexcept { return decoder_; }
    /// @brief Dispatcher for the Link.
    [[nodiscard]] const Dispatcher& dispatcher() const noexcept {
        return dispatcher_;
    }

private:
    static wireforge::Status wire(Receiver& receiver, Dispatcher& dispatcher) noexcept {
        const wireforge::Status attached = receiver.attach(dispatcher);
        return wireforge::first_error(attached, dispatcher.start());
    }

    Decoder decoder_{kFrameFormat};
    Dispatcher dispatcher_{kHeaderLayout};
    Receiver receiver_;
    wireforge::Status status_;
};

