/// @brief Appends the wire form of @p value to @p encoder.
inline void encode(const CommandLong& value, wireforge::Encoder& encoder) noexcept {
    encoder.write(value.param1);
    encoder.write(value.param2);
    encoder.write(value.param3);
    encoder.write(value.param4);
    encoder.write(value.param5);
    encoder.write(value.param6);
    encoder.write(value.param7);
    encoder.write(value.command);
    encoder.write(value.targetSystem);
    encoder.write(value.targetComponent);
    encoder.write(value.confirmation);
}

/// @brief Reads @p value from @p decoder.
inline void decode(CommandLong& value, wireforge::Decoder& decoder) noexcept {
    decoder.read(value.param1);
    decoder.read(value.param2);
    decoder.read(value.param3);
    decoder.read(value.param4);
    decoder.read(value.param5);
    decoder.read(value.param6);
    decoder.read(value.param7);
    decoder.read(value.command);
    decoder.read(value.targetSystem);
    decoder.read(value.targetComponent);
    decoder.read(value.confirmation);
}

/// @brief Encoding of CommandLong without interface overrides.
inline constexpr wireforge::Encoding kCommandLongEncoding = wireforge::Encoding{wireforge::Endian::Little, wireforge::BitOrder::LsbFirst, true, true, false};

/**
 * @brief Encodes the payload of a CommandLong message into @p buffer.
 * @param value Message to encode.
 * @param buffer Destination of the payload.
 * @param[out] size Number of bytes written (0 on error).
 * @param encoding Byte order, bit order and range checks.
 * @return The first error, or wireforge::Status::Ok.
 */
[[nodiscard]] inline wireforge::Status serialize(const CommandLong& value, wireforge::Span<std::uint8_t> buffer, std::size_t& size, const wireforge::Encoding& encoding = kCommandLongEncoding) noexcept {
    wireforge::Encoder encoder(buffer, encoding);
    encode(value, encoder);
    size = encoder.status() == wireforge::Status::Ok ? encoder.position() : 0U;
    return encoder.status();
}

/**
 * @brief Decodes the payload of a CommandLong message.
 * @param payload Encoded payload.
 * @param[out] value Decoded message (partially filled on error).
 * @param encoding Byte order, bit order and range checks.
 * @return The first error, or wireforge::Status::Ok.
 */
[[nodiscard]] inline wireforge::Status deserialize(wireforge::Span<const std::uint8_t> payload, CommandLong& value, const wireforge::Encoding& encoding = kCommandLongEncoding) noexcept {
    wireforge::Decoder decoder(payload, encoding);
    decode(value, decoder);
    decoder.finish();
    return decoder.status();
}

/// @brief The answer to a command (COMMAND_ACK); the last four fields are extensions.
/// Defined in project.yaml:125 (/messages/CommandAck).
/// Requirements: MAV2-003, MAV2-004; LLR-CommandAck.LAYOUT, LLR-CommandAck.SIZE,
/// LLR-CommandAck.TRUNCATED, LLR-CommandAck.TRAILING
struct CommandAck {
    std::uint16_t command{}; ///< command (project.yaml:130)
    std::uint8_t result{}; ///< MAV_RESULT: 0 accepted, 1 temporarily rejected, 2 denied, ... (project.yaml:131)
    std::uint8_t progress{}; ///< Progress in percent while in progress (extension). (project.yaml:132)
    std::int32_t resultParam2{}; ///< Additional result information (extension). (project.yaml:133)
    std::uint8_t targetSystem{}; ///< The system that sent the command (extension). (project.yaml:134)
    std::uint8_t targetComponent{}; ///< The component that sent the command (extension). (project.yaml:135)
};

/// @brief Checks ranges, enum values and element counts of @p value.
[[nodiscard]] constexpr wireforge::Status validate(const CommandAck& value) noexcept {
    static_cast<void>(value);
    return wireforge::Status::Ok;
}

/// @brief Smallest encoded size of CommandAck in bytes.
[[nodiscard]] constexpr std::size_t min_wire_size(wireforge::TypeTag<CommandAck> /*tag*/) noexcept {
    std::size_t size = 0U;
    size += 2U;
    size += 1U;
    size += 1U;
    size += 4U;
    size += 1U;
    size += 1U;
    return size;
}

/// @brief Largest encoded size of CommandAck in bytes.
[[nodiscard]] constexpr std::size_t max_wire_size(wireforge::TypeTag<CommandAck> /*tag*/) noexcept {
    std::size_t size = 0U;
    size += 2U;
    size += 1U;
    size += 1U;
    size += 4U;
    size += 1U;
    size += 1U;
    return size;
}

/// @brief Appends the wire form of @p value to @p encoder.
inline void encode(const CommandAck& value, wireforge::Encoder& encoder) noexcept {
    encoder.write(value.command);
    encoder.write(value.result);
    encoder.write(value.progress);
    encoder.write(value.resultParam2);
    encoder.write(value.targetSystem);
    encoder.write(value.targetComponent);
}

/// @brief Reads @p value from @p decoder.
inline void decode(CommandAck& value, wireforge::Decoder& decoder) noexcept {
    decoder.read(value.command);
    decoder.read(value.result);
    decoder.read(value.progress);
    decoder.read(value.resultParam2);
    decoder.read(value.targetSystem);
    decoder.read(value.targetComponent);
}

