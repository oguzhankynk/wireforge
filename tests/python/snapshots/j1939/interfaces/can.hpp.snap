/// @brief Receives the messages of this interface, decoded or as raw bytes.
class Handler {
public:
    /// @brief Called for every valid Eec1 received on this interface.
    virtual void onEec1Received(const Eec1& message) noexcept = 0;
    /**
     * @brief Called for every Eec1 frame before its payload is decoded.
     *
     * The default implementation decodes the payload and calls
     * onEec1Received() when it is valid. Override it to take the
     * bytes without decoding: framing, the frame checksum and the message
     * id were checked, the payload was not. @p raw points into the receive
     * buffer and is valid only during this call.
     * @return Reported to the link; the default returns the decode status.
     */
    virtual wireforge::Status onEec1Raw(
        const wireforge::RawMessage& raw) noexcept {
        Eec1 message{};
        const wireforge::Status status =
            deserialize(raw.payload, message, kEec1Encoding);
        if (status == wireforge::Status::Ok) {
            onEec1Received(message);
        }
        return status;
    }
    /// @brief Called for every valid Ccvs received on this interface.
    virtual void onCcvsReceived(const Ccvs& message) noexcept = 0;
    /**
     * @brief Called for every Ccvs frame before its payload is decoded.
     *
     * The default implementation decodes the payload and calls
     * onCcvsReceived() when it is valid. Override it to take the
     * bytes without decoding: framing, the frame checksum and the message
     * id were checked, the payload was not. @p raw points into the receive
     * buffer and is valid only during this call.
     * @return Reported to the link; the default returns the decode status.
     */
    virtual wireforge::Status onCcvsRaw(
        const wireforge::RawMessage& raw) noexcept {
        Ccvs message{};
        const wireforge::Status status =
            deserialize(raw.payload, message, kCcvsEncoding);
        if (status == wireforge::Status::Ok) {
            onCcvsReceived(message);
        }
        return status;
    }
    /// @brief Called for every valid Et1 received on this interface.
    virtual void onEt1Received(const Et1& message) noexcept = 0;
    /**
     * @brief Called for every Et1 frame before its payload is decoded.
     *
     * The default implementation decodes the payload and calls
     * onEt1Received() when it is valid. Override it to take the
     * bytes without decoding: framing, the frame checksum and the message
     * id were checked, the payload was not. @p raw points into the receive
     * buffer and is valid only during this call.
     * @return Reported to the link; the default returns the decode status.
     */
    virtual wireforge::Status onEt1Raw(
        const wireforge::RawMessage& raw) noexcept {
        Et1 message{};
