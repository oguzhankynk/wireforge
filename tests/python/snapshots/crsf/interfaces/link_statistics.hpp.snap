/// @brief Header fields set by the sender (ids, lengths, constants are automatic).
struct Header {
};

/// @cond INTERNAL
namespace detail {

template <typename Payload>
[[nodiscard]] wireforge::Status write_frame(const Header& header, MessageId message_id,
                                   wireforge::Span<std::uint8_t> buffer, std::size_t& size,
                                   Payload&& payload) noexcept {
    constexpr wireforge::Status kOk = wireforge::Status::Ok;
    size = 0U;
    static_cast<void>(header);
    static_cast<void>(message_id);
    if (buffer.size() < kHeaderSize + kTrailerSize) {
        return wireforge::Status::BufferTooSmall;
    }
    std::size_t payload_size = 0U;
    const std::size_t room = buffer.size() - kHeaderSize - kTrailerSize;
    const wireforge::Status status =
        std::forward<Payload>(payload)(buffer.subspan(kHeaderSize, room), payload_size);
    if (status != kOk) {
        return status;
    }
    const std::size_t total = kHeaderSize + payload_size + kTrailerSize;
    wireforge::Encoder head(buffer.first(kHeaderSize), kFrameEncoding);
    head.write<std::uint8_t>(200U);
    head.write_count<std::uint8_t>(payload_size + kTrailerSize);
    wireforge::Encoder tail(buffer.subspan(kHeaderSize + payload_size, kTrailerSize), kFrameEncoding);
    tail.write<std::uint8_t>(static_cast<std::uint8_t>(wireforge::compute_checksum<checksums::crc8>(wireforge::Span<const std::uint8_t>(buffer.subspan(kHeaderSize, payload_size)))));
    head.check(tail.status());
    head.check(wireforge::status_if(total <= kMaxFrameSize, wireforge::Status::InvalidLength));
    size = wireforge::size_if_ok(head.status(), total);
    return head.status();
}

} // namespace detail
