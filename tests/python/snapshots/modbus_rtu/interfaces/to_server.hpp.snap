    [[nodiscard]] wireforge::Status attach(Dispatcher& dispatcher) noexcept {
        return wireforge::first_error(
            dispatcher.add(kReadHoldingRegistersRequestId, wireforge::MessageHandler::bind<&Receiver::receiveReadHoldingRegistersRequest>(*this)),
            dispatcher.add(kWriteSingleRegisterId, wireforge::MessageHandler::bind<&Receiver::receiveWriteSingleRegister>(*this)),
            wireforge::Status::Ok);
    }

private:
    wireforge::Status receiveReadHoldingRegistersRequest(const wireforge::RawMessage& raw) noexcept {
        const wireforge::Status checked = detail::check_frame(raw.frame);
        return checked == wireforge::Status::Ok ? handler_->onReadHoldingRegistersRequestRaw(raw) : checked;
    }

    wireforge::Status receiveWriteSingleRegister(const wireforge::RawMessage& raw) noexcept {
        const wireforge::Status checked = detail::check_frame(raw.frame);
        return checked == wireforge::Status::Ok ? handler_->onWriteSingleRegisterRaw(raw) : checked;
    }

    Handler* handler_;
};

