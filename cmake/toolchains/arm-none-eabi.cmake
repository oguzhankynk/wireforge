# Bare-metal Arm Cortex-M4F with newlib-nano, for the FreeRTOS test project (tests/rtos).
# WIREFORGE_RTOS_TOOLS (optional) is a tree extracted by quality/fetch_rtos_tools.sh, whose
# compiler cannot find its libraries by itself; with the Debian/Ubuntu packages installed nothing
# needs to be set.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if(NOT WIREFORGE_RTOS_TOOLS)
  set(WIREFORGE_RTOS_TOOLS "$ENV{WIREFORGE_RTOS_TOOLS}")
endif()
set(search_paths "")
if(WIREFORGE_RTOS_TOOLS)
  set(search_paths "${WIREFORGE_RTOS_TOOLS}/usr/bin")
endif()
find_program(CMAKE_C_COMPILER arm-none-eabi-gcc HINTS ${search_paths} REQUIRED)
find_program(CMAKE_CXX_COMPILER arm-none-eabi-g++ HINTS ${search_paths} REQUIRED)
find_program(CMAKE_ASM_COMPILER arm-none-eabi-gcc HINTS ${search_paths} REQUIRED)

if(NOT cpu_flags) # arm-none-eabi-cortex-m7.cmake sets its own
  set(cpu_flags "-mcpu=cortex-m4 -mthumb -mfloat-abi=hard -mfpu=fpv4-sp-d16")
  set(multilib_path "thumb/v7e-m+fp/hard")
endif()
set(tool_flags "")
if(WIREFORGE_RTOS_TOOLS)
  set(newlib "${WIREFORGE_RTOS_TOOLS}/usr/lib/arm-none-eabi/newlib")
  set(multilib "${newlib}/${multilib_path}")
  set(include "${WIREFORGE_RTOS_TOOLS}/usr/include/newlib")
  set(tool_flags "-isystem ${include}")
  file(GLOB cxx_version LIST_DIRECTORIES true "${include}/c++/*")
  foreach(directory ${cxx_version})
    string(APPEND tool_flags " -isystem ${directory}"
           " -isystem ${directory}/arm-none-eabi/${multilib_path}")
  endforeach()
  set(link_flags "-B${multilib} -L${multilib} -B${newlib} --specs=${newlib}/nosys.specs")
  set(nano "-specs=${newlib}/nano.specs")
else()
  set(link_flags "--specs=nosys.specs")
  set(nano "-specs=nano.specs")
endif()
set(CMAKE_C_FLAGS_INIT "${cpu_flags} ${tool_flags} -ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "${cpu_flags} ${tool_flags} -ffunction-sections -fdata-sections")
set(CMAKE_ASM_FLAGS_INIT "${cpu_flags}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${cpu_flags} ${link_flags} ${nano} -Wl,--gc-sections")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
