# Documented exclusions live in quality/QUALITY_POLICY.md ("Check exclusions").
Checks: >
  -*,
  bugprone-*,
  cert-*,
  cppcoreguidelines-*,
  performance-*,
  portability-*,
  misc-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -misc-include-cleaner
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(runtime|codegen|tests)/.*'
FormatStyle: file
