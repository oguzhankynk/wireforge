{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer build (warnings are errors)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan-ubsan",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": { "WIREFORGE_SANITIZE": "address,undefined" }
    },
    {
      "name": "tsan",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": { "WIREFORGE_SANITIZE": "thread" }
    },
    {
      "name": "unsigned-char",
      "displayName": "Plain char is unsigned, as on ARM",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/unsigned-char",
      "cacheVariables": { "WIREFORGE_UNSIGNED_CHAR": "ON" }
    },
    {
      "name": "coverage",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": { "WIREFORGE_COVERAGE": "ON" }
    },
    {
      "name": "gcc-analyzer",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/gcc-analyzer",
      "cacheVariables": { "WIREFORGE_GCC_ANALYZER": "ON" }
    },
    {
      "name": "clang-everything",
      "displayName": "Clang -Weverything on production code and self-tests",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/clang-everything",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "WIREFORGE_BUILD_TESTS": "OFF",
        "WIREFORGE_WEVERYTHING": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer targets (Clang)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": { "WIREFORGE_FUZZ": "ON", "CMAKE_CXX_COMPILER": "clang++" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "unsigned-char", "configurePreset": "unsigned-char" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "gcc-analyzer", "configurePreset": "gcc-analyzer" },
    { "name": "clang-everything", "configurePreset": "clang-everything" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } },
    { "name": "unsigned-char", "configurePreset": "unsigned-char", "output": { "outputOnFailure": true } },
    { "name": "coverage", "configurePreset": "coverage", "output": { "outputOnFailure": true } },
    { "name": "gcc-analyzer", "configurePreset": "gcc-analyzer", "output": { "outputOnFailure": true } },
    { "name": "clang-everything", "configurePreset": "clang-everything", "output": { "outputOnFailure": true } }
  ]
}
